*.avi
*.mov
*.mkv
*.webm
*.flv
*.ts
*.h264
*.hevc

# ---- 7. Jupyter Notebook & Checkpoints ----
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---- 8. IDEs, Editors & OS Specific Files ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.bak

